<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#AAB8FF</item>
        <item name="android:windowBackground">#141822</item>
        <item name="android:navigationBarColor">#141822</item>
        <item name="android:statusBarColor">#141822</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorBackground">#1F2533</item>
        <item name="android:textColorPrimary">#EBEFF9</item>
        <item name="android:textColorSecondary">#A4AEC3</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="AppTheme.Light" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#3D5ADB</item>
        <item name="android:windowBackground">#F5F7FC</item>
        <item name="android:navigationBarColor">#F5F7FC</item>
        <item name="android:statusBarColor">#F5F7FC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:textColorPrimary">#212C42</item>
        <item name="android:textColorSecondary">#728096</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>

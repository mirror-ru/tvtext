# Keep source and documentation stable across Windows and Unix checkouts.
* text=auto
*.cs text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.ps1 text eol=lf
*.xml text eol=lf
*.md text eol=lf

# Treat generated/release formats as binary if they are ever inspected locally.
*.apk binary
*.aab binary
*.exe binary
*.dll binary
*.ico binary
*.p12 binary
*.pfx binary
*.jks binary
